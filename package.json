{
  "name": "sistema-restaurante",
  "version": "0.1.0",
  "private": true,
  "description": "Gestão de Marmitaria — Cantinho do Sabor",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,yellow \"npm run dev -w server\" \"npm run dev -w client\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w server",
    "db:seed": "npm run seed -w server",
    "db:reset": "npm run reset -w server",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
